<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Add CompHauledToInventory to all Pawns -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[thingClass="Pawn"]/comps</xpath>
    <value>
      <li>
        <compClass>SmartHaul.CompHauledToInventory</compClass>
      </li>
    </value>
  </Operation>
</Patch>