<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
    <!-- General -->
    <SH.SettingsGeneral>Основные настройки</SH.SettingsGeneral>
    <SH.AllowCorpses>Класть трупы в инвентарь</SH.AllowCorpses>
    <SH.AllowCorpsesTooltip>По умолчанию выкл. Иначе трупы носят только в руках.</SH.AllowCorpsesTooltip>
    <SH.AllowAnimals>Разрешить вьючным животным использовать инвентарь</SH.AllowAnimals>
    <SH.AllowAnimalsTooltip>По умолчанию вкл. Лучше работает с модами на рюкзаки для животных.</SH.AllowAnimalsTooltip>
    <SH.AllowMechanoids>Разрешить механоидам использовать инвентарь</SH.AllowMechanoids>
    <SH.AllowMechanoidsTooltip>Требует What The Hack или аналоги. По умолчанию вкл.</SH.AllowMechanoidsTooltip>
    <SH.MinFreeInventory>Минимум свободного места в инвентаре</SH.MinFreeInventory>
    <SH.MinFreeInventoryTooltip>Пешки с меньшим свободным местом будут носить обычным способом. По умолчанию 20%</SH.MinFreeInventoryTooltip>

    <!-- Overlay -->
    <SH.SettingsOverlay>Визуальное отображение</SH.SettingsOverlay>
    <SH.ShowHaulOverlay>Показывать очередь переноски</SH.ShowHaulOverlay>
    <SH.ShowHaulOverlayTooltip>Подчёркивает предметы, которые пешки собираются нести.</SH.ShowHaulOverlayTooltip>
    <SH.ShowPawnName>Показывать имя носильщика</SH.ShowPawnName>
    <SH.ShowPawnNameTooltip>Показывает имя пешки, которая несёт предмет.</SH.ShowPawnNameTooltip>
    <SH.PawnNameMaxChars>Макс. символов имени: {0}</SH.PawnNameMaxChars>
    <SH.OverlayAllFactions>Показывать для всех фракций</SH.OverlayAllFactions>
    <SH.OverlayAllFactionsTooltip>Если выкл., показывает только для ваших колонистов.</SH.OverlayAllFactionsTooltip>

    <!-- Route -->
    <SH.SettingsRoute>Построение маршрута</SH.SettingsRoute>
    <SH.MaxNeighborDistance>Макс. расстояние поиска: {0} клеток</SH.MaxNeighborDistance>
    <SH.MaxCandidates>Макс. предметов за рейс: {0}</SH.MaxCandidates>
    <SH.RotUrgentHours>Срочность гниющего: {0} часов</SH.RotUrgentHours>
    <SH.WornThreshold>Порог износа: {0}% HP</SH.WornThreshold>

    <!-- Cooperation -->
    <SH.SettingsCooperation>Кооперация</SH.SettingsCooperation>
    <SH.NotifyOtherPawns>Уведомлять других пешек</SH.NotifyOtherPawns>
    <SH.NotifyOtherPawnsTooltip>Когда инвентарь полон, уведомить ближайших бездельников помочь.</SH.NotifyOtherPawnsTooltip>

